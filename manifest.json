{
  "manifest_version": 3,
  "name": "Private Job Autofill",
  "version": "2.3.0",
  "description": "Privacy-first, zero-lag job application autofill with an application tracker, multiple profiles, cover-letter templates and Shadow DOM support. 100% local storage. No tracking, no telemetry, no external requests.",
  "permissions": ["storage", "unlimitedStorage", "activeTab", "scripting"],
  "host_permissions": [
    "*://*.greenhouse.io/*",
    "*://*.lever.co/*",
    "*://*.myworkdayjobs.com/*",
    "*://*.workday.com/*",
    "*://*.icims.com/*",
    "*://*.smartrecruiters.com/*",
    "*://*.taleo.net/*",
    "*://*.successfactors.com/*",
    "*://*.sapsf.com/*",
    "*://*.workable.com/*",
    "*://*.jobvite.com/*",
    "*://*.ashbyhq.com/*",
    "*://*.recruitee.com/*",
    "*://*.bamboohr.com/*",
    "*://*.breezy.hr/*",
    "*://*.jazzhr.com/*",
    "*://*.ultipro.com/*",
    "*://*.personio.com/*",
    "*://*.applicantstack.com/*",
    "*://*.recruiterbox.com/*"
  ],
  "optional_host_permissions": ["*://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "fill-active-form": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Fill the current job application"
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Private Job Autofill"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}

